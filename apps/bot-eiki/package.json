{
  "name": "@apps/eiki",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --dts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings=0",
    "test": "vitest run",
    "format": "prettier -w .",
    "deploy:dev": "tsx ./deploy-commands.ts"
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "zod": "^3.23.8",
    "dotenv": "^16.4.5",
    "@packages/shared": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.1",
    "typescript": "^5.6.3",
    "tsx": "^4.19.2",
    "vitest": "^2.1.3",
    "eslint": "^9.9.0",
    "@typescript-eslint/parser": "^8.7.0",
    "@typescript-eslint/eslint-plugin": "^8.7.0",
    "prettier": "^3.3.3"
  }
}
