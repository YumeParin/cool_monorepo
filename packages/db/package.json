{
  "name": "@swissokyo/db",
  "version": "1.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "commonjs",
  "files": [
    "dist",
    "generated",
    "prisma",
    "prisma.config.ts"
  ],
  "scripts": {
    "prepare:dev": "npm run step:generate && npm run step:compile && npm run step:infra && npm run step:migrate-dev",
    "prepare:prod": "npm run step:generate && npm run step:compile && npm run step:migrate-deploy",
    "step:generate": "npx prisma generate",
    "step:compile": "tsc && tsc-alias",
    "step:infra": "docker compose up -d --build",
    "step:migrate-dev": "npx prisma migrate dev",
    "step:migrate-deploy": "npx prisma migrate deploy"
  },
  "dependencies": {
    "prisma": "^7.3.0",
    "@prisma/adapter-pg": "^7.3.0",
    "@types/pg": "^8.16.0",
    "@prisma/client": "^7.3.0",
    "pg": "^8.17.2",
    "dotenv": "^17.2.3"
  },
  "devDependencies": {
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
