// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Server {
  id  String @id
  members Member[]
  welcomeChannelId String?
  generalChannelId String?
  gapChannelId String?
}

model Member {
  id String @id
  servers Server[]
  wasWelcomed Boolean @default(false)
  gappedSince DateTime?
  
}
